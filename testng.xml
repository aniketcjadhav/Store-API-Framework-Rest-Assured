<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="API Suite" thread-count="5" parallel="tests">

    <listeners>
        <listener class-name="utils.ExtentReporter"/>
    </listeners>

    <test name="UserTest">
        <classes>
            <class name="testcases.UserTests"/>
        </classes>
    </test>

    <test name="ProductTest">
        <classes>
            <class name="testcases.ProductTests"/>
        </classes>
    </test>
    
    <test name="Product Data Driven Test">
        <classes>
            <class name="testcases.ProductDataDrivenTest"/>
        </classes>
    </test>
    
     <test name="Cart Test">
        <classes>
            <class name="testcases.CartTests"/>
        </classes>
    </test>

</suite>